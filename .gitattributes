# 行尾规范：仓库内统一 LF，检出时按平台/类型转换
* text=auto

# PowerShell 脚本：Windows 原生 CRLF（PS 5.1 的 here-string 对其最稳妥）
*.ps1 text eol=crlf

# 批处理：必须 CRLF，且不含 BOM（否则 cmd 会尝试执行 BOM 那几个字节）
*.bat text eol=crlf

# 文本类统一 LF
*.md    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf

# 二进制（本仓库不应出现，仅作保险）
*.exe binary
*.dll binary
*.sys binary
*.zip binary
